# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Local open model (vLLM / llama.cpp / Ollama exposing an OpenAI-compatible API).
# The key is a placeholder: local servers ignore it. Use a real provider key instead if you prefer.
# OPENAI_BASE_URL=http://127.0.0.1:4040/v1
# OPENAI_API_KEY=local-placeholder
# AGENT_MODEL=qwen3.5-9b
# AGENT_ENGINE_PREFER_BYO_KEY=true
# AGENT_MAX_OUTPUT_TOKENS=8000              # cap output for small-context local models
# AGENT_MAIN_CHAT_MAX_OUTPUT_TOKENS=8000
# AGENT_EMPTY_RESPONSE_RETRY_MAX_OUTPUT_TOKENS=8000
